{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reconciliation-report.schema.json",
  "title": "Reconciliation report",
  "description": "What actually happened at one storefront after a publication attempt, from read-after-write checks. Never retries or rolls back.",
  "type": "object",
  "required": [
    "contract",
    "contract_version",
    "destination",
    "environment",
    "change_set_id",
    "verified_state",
    "operations",
    "checked_at",
    "recommended_action"
  ],
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "reconciliation-report"
    },
    "contract_version": {
      "const": 1
    },
    "destination": {
      "$ref": "common.schema.json#/$defs/storefront_id"
    },
    "environment": {
      "$ref": "common.schema.json#/$defs/environment"
    },
    "change_set_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "verified_state": {
      "$ref": "common.schema.json#/$defs/publication_state"
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "attempt_id",
          "state"
        ],
        "additionalProperties": false,
        "properties": {
          "attempt_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "state": {
            "$ref": "common.schema.json#/$defs/publication_state"
          },
          "receipt_id": {
            "type": "string"
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "seq",
          "key",
          "result"
        ],
        "additionalProperties": false,
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 1
          },
          "key": {
            "type": "string"
          },
          "result": {
            "enum": [
              "match",
              "mismatch",
              "not_found",
              "not_checked"
            ]
          },
          "mismatched_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "result": {
                  "const": "mismatch"
                }
              }
            },
            "then": {
              "required": [
                "mismatched_fields"
              ]
            }
          }
        ]
      }
    },
    "checked_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "recommended_action": {
      "enum": [
        "none",
        "recheck",
        "operator_review",
        "retry_reconciliation"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verified_state": {
            "const": "SUCCEEDED"
          }
        }
      },
      "then": {
        "properties": {
          "operations": {
            "items": {
              "properties": {
                "result": {
                  "const": "match"
                }
              }
            }
          }
        }
      }
    }
  ]
}

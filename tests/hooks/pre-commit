#!/usr/bin/env bash
# Block any commit that breaks the Commerce OS test suite.
# Install once per clone:  ./tests/install-hooks.sh
# Bypass in a genuine emergency only:  git commit --no-verify
cd "$(git rev-parse --show-toplevel)"
LOG="${TMPDIR:-/tmp}/commerce-os-precommit.log"
if ! ./run-tests.sh >"$LOG" 2>&1; then
  echo "✗ Commerce OS tests failed — commit blocked."
  tail -25 "$LOG"
  echo; echo "Fix the failures, or see the full log: $LOG"
  exit 1
fi
echo "✓ Commerce OS tests passed"

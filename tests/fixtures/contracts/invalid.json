{
  "description": "Each case patches a valid fixture and must fail validation with an error mentioning `expect`. Paths are dotted, with [n] for list items.",
  "cases": [
    {"name": "unknown fact carries a value", "fixture": "canonical-draft.hat-two-colors",
     "set": {"product.brand": {"value": "Acme", "status": "unknown", "evidence": []}}, "expect": "$.product.brand.value"},
    {"name": "commercial fact inferred from a photo", "fixture": "canonical-draft.hat-two-colors",
     "set": {"product.material.status": "inferred"}, "expect": "$.product.material.status"},
    {"name": "price in the canonical draft", "fixture": "canonical-draft.hat-two-colors",
     "set": {"product.price": {"value": {"amount_minor": 2800, "currency": "USD"}, "status": "supplied", "evidence": [{"kind": "manifest_field", "ref": "manifest.price"}]}},
     "expect": "$.product.price: not allowed"},
    {"name": "human-confirmed field without a decision", "fixture": "canonical-draft.hat-two-colors",
     "delete": ["product.title.decision"], "expect": "missing required 'decision'"},
    {"name": "observed color without evidence", "fixture": "product-proposal.hat-two-colors",
     "set": {"products[0].variants[0].observed_color.evidence": []}, "expect": "observed_color.evidence: fewer than 1"},
    {"name": "rejected file without a reason", "fixture": "source-manifest.hat-two-colors",
     "delete": ["files[3].rejection_reason"], "expect": "missing required 'rejection_reason'"},
    {"name": "crop not marked consequential", "fixture": "derivative-manifest.hat-two-colors",
     "set": {"derivatives[0].operations": ["orient", "crop"]}, "expect": "$.derivatives[0].consequential"},
    {"name": "money as a float", "fixture": "change-set.hat-two-colors",
     "set": {"operations[0].fields.price.value.amount_minor": 28.0}, "expect": "amount_minor: expected integer"},
    {"name": "price from an inference", "fixture": "change-set.hat-two-colors",
     "set": {"operations[0].fields.price.status": "inferred"}, "expect": "fields.price.status"},
    {"name": "unknown price in a change set", "fixture": "change-set.hat-two-colors",
     "set": {"operations[0].fields.price": {"value": null, "status": "unknown"}}, "expect": "fields.price"},
    {"name": "destination status not confirmed by a human", "fixture": "change-set.hat-two-colors",
     "set": {"operations[0].fields.status.status": "inferred"}, "expect": "fields.status.status"},
    {"name": "requested status left implicit", "fixture": "change-set.hat-two-colors",
     "delete": ["requested_status"], "expect": "missing required 'requested_status'"},
    {"name": "create without must_not_exist", "fixture": "change-set.hat-two-colors",
     "set": {"operations[0].precondition": {}}, "expect": "missing required 'must_not_exist'"},
    {"name": "update without an expected row hash", "fixture": "change-set.artwork-update",
     "set": {"operations[0].precondition": {}}, "expect": "missing required 'expected_row_hash'"},
    {"name": "malformed change-set hash", "fixture": "change-set.hat-two-colors",
     "set": {"change_set_hash": "abc"}, "expect": "$.change_set_hash: matches none of anyOf"},
    {"name": "agent approves", "fixture": "approval.hat-two-colors",
     "set": {"actor": {"kind": "agent", "id": "review-publishing", "role": "approver"}}, "expect": "$.actor.kind"},
    {"name": "reviewer (not approver) approves", "fixture": "approval.hat-two-colors",
     "set": {"actor.role": "reviewer"}, "expect": "$.actor.role"},
    {"name": "approval not bound to a change-set hash", "fixture": "approval.hat-two-colors",
     "delete": ["change_set_hash"], "expect": "missing required 'change_set_hash'"},
    {"name": "warning listed as a blocker", "fixture": "review-package.hat-two-colors",
     "set": {"blockers[0].severity": "warning"}, "expect": "blockers[0].severity"},
    {"name": "success without a verified match", "fixture": "reconciliation-report.hat-two-colors",
     "set": {"verified_state": "SUCCEEDED"}, "expect": "operations[0].result"},
    {"name": "wrong contract name", "fixture": "product-proposal.hat-two-colors",
     "set": {"contract": "source-manifest"}, "expect": "$.contract"}
  ],
  "semantic_cases": [
    {"name": "color option on artwork", "fixture": "canonical-draft.artwork-original",
     "set": {"product.option_definitions": [{"key": "color", "label": "Color", "values": ["blue"]}]}, "expect": "color option not allowed"},
    {"name": "two variants with the same options", "fixture": "canonical-draft.hat-two-colors",
     "set": {"variants[1].option_values": {"color": "navy"}}, "expect": "duplicate option values"},
    {"name": "variant value not in its option definition", "fixture": "canonical-draft.hat-two-colors",
     "set": {"variants[1].option_values": {"color": "green"}}, "expect": "not in option definition"},
    {"name": "image grouped twice", "fixture": "product-proposal.hat-two-colors",
     "set": {"grouping[2].file_id": "file-hat-front-navy"}, "expect": "grouped more than once"},
    {"name": "approval prepared and approved by the same actor", "fixture": "approval.hat-two-colors",
     "set": {"prepared_by": {"kind": "human", "id": "user-approver-1", "role": "approver"}}, "expect": "self-approval"},
    {"name": "approval hash differs from its change set", "fixture": "approval.hat-two-colors",
     "set": {"mapping_version": 2}, "expect": "mapping_version"}
  ]
}

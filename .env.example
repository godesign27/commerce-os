# Commerce OS — example configuration. EVERY VALUE HERE IS FAKE.
# Copy to .env for local development and fill in values for your own test infrastructure.
# Never commit .env. Never put production credentials in a development environment.
#
# Three separate database boundaries are mandatory (PRD §5). Each has its own URL and its own
# credentials. Do not reuse a credential across these blocks.

COMMERCE_OS_ENV=development

# --- Kill switch: when true, no storefront write is dispatched (PRD §13) ---
COMMERCE_OS_WRITES_DISABLED=true

# --- 1. Commerce OS operational database (submissions, drafts, evidence, jobs, approvals, audit) ---
OPS_DB_URL=postgresql://ops_user:fake-password@localhost:54322/commerce_os_dev
OPS_DB_SERVICE_ROLE_KEY=fake-ops-service-role-key

# --- 2. Storefront A (read-only identity first; write identity only in Phase 3, server-side only) ---
STOREFRONT_A_DB_URL=postgresql://readonly:fake-password@localhost:54422/storefront_a_dev
STOREFRONT_A_READ_KEY=fake-storefront-a-read-key
# STOREFRONT_A_WRITE_KEY=  (Phase 3; never exposed to the dashboard, prompts, or agent tools)

# --- 3. Storefront B (separate project, separate credentials) ---
STOREFRONT_B_DB_URL=postgresql://readonly:fake-password@localhost:54522/storefront_b_dev
STOREFRONT_B_READ_KEY=fake-storefront-b-read-key
# STOREFRONT_B_WRITE_KEY=  (Phase 3)

# --- Google Drive intake (Phase 2) ---
DRIVE_SERVICE_ACCOUNT_JSON_PATH=./secrets/fake-drive-service-account.json
DRIVE_INTAKE_ROOT_FOLDER_ID=fake-folder-id
DRIVE_CHANNEL_TOKEN=fake-channel-verification-token

# --- Workflow interface used by Claude Code / Cursor entry points ---
COMMERCE_OS_WORKFLOW_URL=http://localhost:8787
COMMERCE_OS_WORKFLOW_TOKEN=fake-local-dev-token
